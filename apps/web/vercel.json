{
  "redirects": [
    {
      "source": "/tutorials",
      "destination": "/docs/tutorials",
      "permanent": true
    },
    {
      "source": "/tutorials/:match*",
      "destination": "/docs/tutorials/:match*",
      "permanent": true
    },
    {
      "source": "/how-to",
      "destination": "/docs/how-to",
      "permanent": true
    },
    {
      "source": "/how-to/:match*",
      "destination": "/docs/how-to/:match*",
      "permanent": true
    },
    {
      "source": "/reference",
      "destination": "/docs/reference",
      "permanent": true
    },
    {
      "source": "/reference/:match*",
      "destination": "/docs/reference/:match*",
      "permanent": true
    },
    {
      "source": "/explanation",
      "destination": "/docs/explanation",
      "permanent": true
    },
    {
      "source": "/explanation/:match*",
      "destination": "/docs/explanation/:match*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://halycron.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://halycron.mintlify.dev/docs/:match*"
    }
  ]
}