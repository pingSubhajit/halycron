# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/halycon"
UPSTASH_REDIS_REST_URL="https://<your-upstash-host>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_BUCKET_NAME="your-bucket-name"

# Authentication & Security
# Generate a strong random string for BETTER_AUTH_SECRET
BETTER_AUTH_SECRET="replace_with_strong_random_string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Session lifetime / sliding expiry (production defaults are in code)
# - `HALYCRON_SESSION_TTL_DAYS`: how long a session remains valid without activity (default 30)
# - `HALYCRON_SESSION_REFRESH_THRESHOLD_DAYS`: refresh when session has <= N days left (default 7)
HALYCRON_SESSION_TTL_DAYS="30"
HALYCRON_SESSION_REFRESH_THRESHOLD_DAYS="7"

# Session lifetime / sliding expiry (production defaults are in code)
# - `HALYCRON_SESSION_TTL_DAYS`: how long a session remains valid without activity (default 30)
# - `HALYCRON_SESSION_REFRESH_THRESHOLD_DAYS`: refresh when session has <= N days left (default 7)
HALYCRON_SESSION_TTL_DAYS="30"
HALYCRON_SESSION_REFRESH_THRESHOLD_DAYS="7"

# Mail Configuration
RESEND_API_KEY="your_resend_api_key"

# Misc.
DEMO_ACCOUNT_EMAIL="demo_account_email"
NEXT_PUBLIC_DEMO_ACCOUNT_EMAIL="demo_account_email"

# QStash Configuration
QSTASH_TOKEN="qstash_token"
QSTASH_CURRENT_SIGNING_KEY="qstash_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="qstash_next_signing_key"
SETUP_SECRET="random_string_for_setting_up_qstash"